# Contact form email delivery (https://resend.com)
# Required: create a Resend account, generate an API key, and set this in
# your Vercel project's Environment Variables.
RESEND_API_KEY=

# Optional: once you've verified hd-networks.com as a sending domain in
# Resend, set this to send from your own domain instead of the shared
# Resend testing address. Format: "Name <address@yourdomain.com>"
# RESEND_FROM_EMAIL=HD Networks Website <noreply@hd-networks.com>
